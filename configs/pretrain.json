{
  "paths": {
    "train_data": "data_pipeline/data/train.bin",
    "val_data": "data_pipeline/data/val.bin",
    "tokenizer_vocab": "bpe/tokenizer",
    "out_root": "output/train_logs",
    "resume": null
  },
  "model": {
    "vocab_size": 8192,
    "context_length": 4096,
    "n_head": 8,
    "theta": 10000.0,
    "num_layers": 12,
    "d_model": 512,
    "d_ff": 2048
  },
  "train": {
    "device": "auto",
    "seed": 42,
    "sequence_length": 2048,
    "batch_size": 1,
    "tokens_per_update": 32768,
    "precision": "bfloat16",
    "activation_checkpointing": false,
    "require_flash_attention": true,
    "max_iters": 93277,
    "eval_interval": 1000,
    "eval_tokens": 262144,
    "log_interval": 10
  },
  "optimizer": {
    "weight_decay": 0.01,
    "max_norm": 1.0
  },
  "lr_schedule": {
    "max_lr": 0.0006,
    "min_lr": 0.00006,
    "warmup_iters": 1000,
    "lr_decay_iters": 93277
  },
  "logging": {
    "use_wandb": false,
    "wandb_project": "training-260114-orig",
    "checkpoint_interval_multiplier": 10
  },
  "sample": {
    "prompt": "你好，我是",
    "max_new_tokens": 100,
    "temperature": 0.7,
    "top_p": 0.95
  }
}
