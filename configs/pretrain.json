{
  "paths": {
    "train_data": "data_pipeline/data/minimind/train.bin",
    "val_data": "data_pipeline/data/minimind/val.bin",
    "tokenizer_vocab": "bpe/tokenizer_24576",
    "out_root": "output/train_logs",
    "resume": null
  },
  "model": {
    "vocab_size": 24576,
