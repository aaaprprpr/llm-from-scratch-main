    },
    "fineweb_edu_zh_4_5": {
      "kind": "hf_dataset",
      "repo": "opencsg/Fineweb-Edu-Chinese-V2.1",
      "split": "train",
      "path": "dataset/data_pipeline/data/downloads/fineweb_edu_zh_4_5",
      "adapter": "text_only",
      "data_files": {
        "train": "4_5/*.parquet"
      }
    },
    "finewiki_zh": {
      "kind": "hf_dataset",
      "repo": "HuggingFaceFW/finewiki",
      "split": "train",
      "path": "dataset/data_pipeline/data/downloads/finewiki_zh",
      "adapter": "text_only",
      "config": "zh",
      "data_files": {
        "train": "data/zhwiki/*.parquet"
      }
    },
    "wiki_zh_20231101": {
      "kind": "hf_dataset",
      "repo": "wikimedia/wikipedia",
      "split": "train",
      "path": "dataset/data_pipeline/data/downloads/wiki_zh_20231101",
      "adapter": "plain_text",
      "config": "20231101.zh"
    },
    "tigerresearch_pretrain_zh": {
      "kind": "hf_dataset",
      "repo": "TigerResearch/pretrain_zh",
      "split": "train",
      "path": "dataset/data_pipeline/data/downloads/tigerresearch_pretrain_zh",
      "adapter": "plain_text"
    }
  },
  "download": {
    "sources": [
      "minimind"
    ],
    "cleanup_cache": true
  },
  "preprocess": {
    "sources": [],
    "output": "dataset/data_pipeline/data/preprocessed",
    "fix_text": true,
    "max_repetition_ratio": 0.8,
    "workers": "auto",
    "batch_size": 1000,
    "overwrite": false
  },
  "build_bin": {
    "input": "minimind",
    "tokenizer": "tokenizer/bpe_24576",
    "train_bin": "dataset/data_pipeline/data/minimind_full/train.bin",
    "val_bin": "dataset/data_pipeline/data/minimind_full/val.bin",
    "train_ratio": 0.95,
    "seed": 42,
    "workers": "auto",
    "overwrite": false
  }
}
