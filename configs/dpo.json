{
  "paths": {
    "dataset": "wenbopan/Chinese-dpo-pairs",
    "tokenizer": "bpe/tokenizer",
    "chat_template": "sft/chat_template.jinja",
    "sft_logs": "output/sft_logs",
    "sft_checkpoint": null,
    "tokenized_cache": "output/dpo_cache/wenbopan_chinese_dpo.pt",
    "dpo_logs": "output/dpo_logs",
    "clean_weights": "output/dpo_weights/model.pt",
    "hf_export": "hf/dpo_model",
    "resume": null
  },
  "model": {
    "vocab_size": 8192,
    "context_length": 256,
    "n_head": 8,
    "num_layers": 12,
    "d_model": 512,
    "d_ff": 2048,
    "theta": 10000.0
  },
  "data": {
    "split": "train",
    "max_seq_len": 256
  },
  "train": {
    "device": "auto",
    "precision": "bfloat16",
    "activation_checkpointing": false,
    "require_flash_attention": false,
    "num_workers": 0,
    "micro_batch_size": 8,
    "gradient_accumulation_steps": 1,
    "num_epochs": 1,
    "beta": 0.1,
    "max_learning_rate": 0.000005,
    "min_learning_rate": 0.0000005,
    "warmup_steps": 50,
    "lr_decay_steps": null,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "eval_every": 200,
    "save_every": 1000,
    "eval_batches": 20,
    "val_size": 500,
    "seed": 42,
    "length_bucket_multiplier": 100,
    "average_logprob": false
  },
  "play": {
    "max_new_tokens": 80,
    "temperature": 0.7,
    "top_p": 0.9,
    "prompts": [
      "中国的首都是哪里？",
      "自然语言处理是什么？",
      "请用三句话介绍深度学习。",
      "北京是一座什么样的城市？",
      "我今天吃了",
      "上路被三人越塔，应该怎么办？",
      "写一个 Python 函数，计算列表里所有数字的平均值。"
    ]
  }
}
